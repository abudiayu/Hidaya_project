# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment files — never commit secrets
.env
.env.local
.env.*.local
# .env.production is safe to commit ONLY if it has no secrets (public keys only)

# Large media files — use public/ folder instead, never commit to Git
*.mp4
*.mov
*.avi
*.mkv
*.webm
src/assets/*.mp4
src/assets/*.mov
public/*.mp4

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
node_modules/
dist/
